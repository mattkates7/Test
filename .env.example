# Copy this file to .env  (cp .env.example .env)
# .env is git-ignored. Never commit it.

# PAPER MODE ONLY. Any value other than "paper" makes the program refuse to run.
TRADING_MODE=paper

# Optional: public market-data source used by `fetch-data` (no API key needed).
DATA_SOURCE=coinbase

# DO NOT add wallet private keys, seed phrases, or exchange API secrets here.
# This project never needs them. If the program finds variables such as
# PRIVATE_KEY, SEED_PHRASE, MNEMONIC, API_SECRET or WALLET_KEY with a value,
# it refuses to start.
